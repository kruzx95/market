---
import Layout from '../../layouts/Layout.astro';
import ProductDetailActions from '../../components/react/ProductDetailActions';
import ProductCard from '../../components/ProductCard.astro';
import { THEME_PRESETS } from '../../data/themes';
import storeConfig from '../../data/storeConfig.json';
import { formatRupiah, formatNumber } from '../../utils/currency';
import type { Product } from '../../types';
import {
  Star,
  ShieldCheck,
  Truck,
  RefreshCw,
  ChevronRight,
  Sparkles,
  CheckCircle2,
  Package,
} from 'lucide-react';

export async function getStaticPaths() {
  const allProductsMap = new Map<string, Product>();
  Object.values(THEME_PRESETS).forEach((preset) => {
    preset.products.forEach((p) => allProductsMap.set(p.slug, p));
  });
  
  return Array.from(allProductsMap.values()).map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const allProducts: Product[] = [];
Object.values(THEME_PRESETS).forEach((preset) => {
  preset.products.forEach((p) => {
    if (!allProducts.some((item) => item.id === p.id)) {
      allProducts.push(p);
    }
  });
});
const relatedProducts = allProducts
  .filter((p) => p.id !== product.id && p.category === product.category)
  .slice(0, 3);
---

<Layout
  title={`${product.name} - ${storeConfig.storeName}`}
  description={`${product.tagline}. ${product.description.slice(0, 150)}...`}
  image={product.images[0]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6 overflow-x-auto whitespace-nowrap pb-1">
      <a href="/" class="hover:text-slate-900 transition-colors">Beranda</a>
      <ChevronRight className="w-3.5 h-3.5" />
      <a href="/#katalog" class="hover:text-slate-900 transition-colors">{product.category}</a>
      <ChevronRight className="w-3.5 h-3.5" />
      <span class="text-slate-900 font-semibold truncate max-w-xs">{product.name}</span>
    </nav>

    <!-- Main Product Layout Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
      
      <!-- LEFT: Image Gallery (Aspect 3:4) -->
      <div class="lg:col-span-6 space-y-4">
        
        <!-- Main Large Image Preview -->
        <div class="aspect-[3/4] w-full rounded-3xl overflow-hidden bg-slate-100 border border-slate-200/80 shadow-sm relative group">
          <img
            id="main-product-image"
            src={product.images[0]}
            alt={product.name}
            class="w-full h-full object-cover object-center transition-all duration-500"
          />

          <!-- Floating Badges -->
          <div class="absolute top-4 left-4 flex flex-col gap-2 z-10">
            {product.discountPercentage && (
              <span class="bg-rose-500 text-white text-xs font-bold px-2.5 py-1 rounded-full shadow-sm">
                Hemat {product.discountPercentage}%
              </span>
            )}
            {product.isBestSeller && (
              <span class="bg-slate-900 text-white text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full shadow-sm flex items-center gap-1">
                <Sparkles className="w-3 h-3 text-amber-400" />
                Best Seller
              </span>
            )}
          </div>
        </div>

        <!-- Thumbnails Selector -->
        {product.images.length > 1 && (
          <div class="flex items-center gap-3 overflow-x-auto pb-2">
            {product.images.map((img, index) => (
              <button
                type="button"
                onclick={`document.getElementById('main-product-image').src = '${img}'`}
                class="w-20 aspect-[3/4] rounded-xl overflow-hidden border-2 border-transparent hover:border-slate-900 focus:border-slate-900 transition-all shrink-0 bg-slate-100"
              >
                <img src={img} alt={`${product.name} thumbnail ${index + 1}`} class="w-full h-full object-cover" />
              </button>
            ))}
          </div>
        )}

      </div>

      <!-- RIGHT: Product Info & Actions -->
      <div class="lg:col-span-6 space-y-6">
        
        <div>
          <div class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-2">
            <span class="uppercase tracking-widest text-[11px] text-slate-500 font-bold">
              {product.brand}
            </span>
            <span>•</span>
            <span class="text-slate-500">{product.category}</span>
          </div>

          <h1 class="font-serif text-2xl sm:text-3xl font-bold text-slate-900 leading-snug">
            {product.name}
          </h1>

          <p class="text-xs sm:text-sm text-slate-500 mt-1.5 leading-relaxed">
            {product.tagline}
          </p>

          <!-- Rating & Sold Count -->
          <div class="flex items-center gap-4 mt-3 pt-3 border-t border-slate-100 text-xs">
            <div class="flex items-center gap-1.5 font-bold text-slate-900">
              <Star className="w-4 h-4 text-amber-400 fill-amber-400" />
              <span>{product.rating}</span>
              <span class="text-slate-400 font-normal">/ 5.0</span>
            </div>
            <span class="text-slate-300">|</span>
            <div class="text-slate-600">
              <strong class="text-slate-900">{formatNumber(product.soldCount)}+</strong> Terjual
            </div>
            <span class="text-slate-300">|</span>
            <div class="text-emerald-700 font-semibold flex items-center gap-1">
              <CheckCircle2 className="w-3.5 h-3.5" />
              <span>Garansi 100% Original</span>
            </div>
          </div>
        </div>

        <!-- Price Section -->
        <div class="p-4 rounded-2xl bg-slate-100/70 border border-slate-200/80 flex items-baseline gap-3">
          <span class="text-2xl sm:text-3xl font-bold text-slate-900">
            {formatRupiah(product.price)}
          </span>
          {product.originalPrice && (
            <span class="text-sm sm:text-base text-slate-400 line-through">
              {formatRupiah(product.originalPrice)}
            </span>
          )}
          {product.discountPercentage && (
            <span class="text-xs font-bold text-rose-600 bg-rose-50 border border-rose-200 px-2 py-0.5 rounded-md">
              Hemat {product.discountPercentage}%
            </span>
          )}
        </div>

        <!-- Interactive Actions (Variants, Sizes, Cart, Sticky Mobile CTA, WhatsApp) -->
        <ProductDetailActions client:load product={product} />

        <!-- Guarantee Pillars -->
        <div class="grid grid-cols-3 gap-3 pt-6 border-t border-slate-200 text-[11px] text-slate-600">
          <div class="flex flex-col items-center text-center p-2.5 rounded-xl bg-white border border-slate-100">
            <Truck className="w-4 h-4 text-slate-900 mb-1" />
            <span class="font-bold text-slate-900">Cek Ongkir</span>
            <span class="text-slate-400 text-[10px]">Otomatis di checkout</span>
          </div>
          <div class="flex flex-col items-center text-center p-2.5 rounded-xl bg-white border border-slate-100">
            <RefreshCw className="w-4 h-4 text-slate-900 mb-1" />
            <span class="font-bold text-slate-900">Tukar Ukuran</span>
            <span class="text-slate-400 text-[10px]">Garansi 7 hari</span>
          </div>
          <div class="flex flex-col items-center text-center p-2.5 rounded-xl bg-white border border-slate-100">
            <ShieldCheck className="w-4 h-4 text-slate-900 mb-1" />
            <span class="font-bold text-slate-900">Pembayaran Aman</span>
            <span class="text-slate-400 text-[10px]">QRIS / VA / COD</span>
          </div>
        </div>

        <!-- Product Details Specs -->
        <div class="space-y-4 pt-4 text-xs">
          <div class="border-t border-slate-200 pt-4">
            <h3 class="font-bold text-slate-900 text-sm mb-2">Deskripsi Produk</h3>
            <p class="text-slate-600 leading-relaxed">
              {product.description}
            </p>
          </div>

          <div class="border-t border-slate-200 pt-4">
            <h3 class="font-bold text-slate-900 text-sm mb-2">Spesifikasi Material</h3>
            <ul class="space-y-1.5 text-slate-600">
              <li>• <strong>Bahan:</strong> {product.material}</li>
              <li>• <strong>Berat Paket:</strong> ± {product.weightGrams} gram</li>
              <li>• <strong>Asal Pengiriman:</strong> {storeConfig.originCity}</li>
            </ul>
          </div>

          <div class="border-t border-slate-200 pt-4">
            <h3 class="font-bold text-slate-900 text-sm mb-2">Petunjuk Perawatan</h3>
            <ul class="space-y-1.5 text-slate-600">
              {product.careInstructions.map((inst) => (
                <li>• {inst}</li>
              ))}
            </ul>
          </div>
        </div>

      </div>

    </div>

    <!-- Related Products -->
    {relatedProducts.length > 0 && (
      <div class="mt-24 pt-12 border-t border-slate-200">
        <h2 class="font-serif text-xl sm:text-2xl font-bold text-slate-900 mb-6">
          Koleksi Terkait Lainnya
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 sm:gap-6">
          {relatedProducts.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      </div>
    )}

  </div>
</Layout>
