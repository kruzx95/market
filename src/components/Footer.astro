---
import storeConfig from '../data/storeConfig.json';
import { ShieldCheck, RefreshCw, Truck, MessageCircle, Heart } from 'lucide-react';
---

<footer class="bg-slate-950 text-slate-300 pt-16 pb-12 mt-20 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- 4 Key Store Pillars / Trust Badges -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 pb-12 border-b border-slate-800 text-slate-300">
      <div class="flex items-start gap-3">
        <div class="p-2.5 rounded-xl bg-slate-900 border border-slate-800 text-emerald-400 shrink-0">
          <Truck className="w-5 h-5" />
        </div>
        <div>
          <h4 class="font-semibold text-sm text-white">Gratis Ongkir</h4>
          <p class="text-xs text-slate-400 mt-0.5">Subsidi ongkir s.d Rp 20rb ke seluruh Indonesia</p>
        </div>
      </div>

      <div class="flex items-start gap-3">
        <div class="p-2.5 rounded-xl bg-slate-900 border border-slate-800 text-emerald-400 shrink-0">
          <ShieldCheck className="w-5 h-5" />
        </div>
        <div>
          <h4 class="font-semibold text-sm text-white">100% Produk Original</h4>
          <p class="text-xs text-slate-400 mt-0.5">Ditenun dari material katun & linen berkualitas tinggi</p>
        </div>
      </div>

      <div class="flex items-start gap-3">
        <div class="p-2.5 rounded-xl bg-slate-900 border border-slate-800 text-emerald-400 shrink-0">
          <RefreshCw className="w-5 h-5" />
        </div>
        <div>
          <h4 class="font-semibold text-sm text-white">Garansi Tukar Size</h4>
          <p class="text-xs text-slate-400 mt-0.5">Kebesaran atau kekecilan? Bisa tukar dalam 7 hari</p>
        </div>
      </div>

      <div class="flex items-start gap-3">
        <div class="p-2.5 rounded-xl bg-slate-900 border border-slate-800 text-emerald-400 shrink-0">
          <MessageCircle className="w-5 h-5" />
        </div>
        <div>
          <h4 class="font-semibold text-sm text-white">CS Fast Response</h4>
          <p class="text-xs text-slate-400 mt-0.5">Bantuan ramah via WhatsApp setiap hari kerja</p>
        </div>
      </div>
    </div>

    <!-- Main Footer Links & Info -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 py-12 border-b border-slate-800">
      
      <!-- Brand column -->
      <div class="md:col-span-5 space-y-4">
        <h3 class="font-serif text-2xl font-bold text-white uppercase tracking-wider">{storeConfig.storeName}</h3>
        <p class="text-sm text-slate-400 max-w-sm leading-relaxed">
          {storeConfig.storeSubtitle}
        </p>
        <div class="pt-2 text-xs text-slate-400 space-y-1.5">
          <p class="flex items-center gap-2">
            <span class="text-slate-200 font-medium">📍 Workshop / Showroom:</span> {storeConfig.address}
          </p>
          <p class="flex items-center gap-2">
            <span class="text-slate-200 font-medium">⏰ Jam Operasional:</span> {storeConfig.operationalHours}
          </p>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="md:col-span-3 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-widest text-slate-200">Koleksi Produk</h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href="/#katalog" class="hover:text-white transition-colors">Kemeja Linen & Cuban</a></li>
          <li><a href="/#katalog" class="hover:text-white transition-colors">Kaos Heavyweight 24s</a></li>
          <li><a href="/#katalog" class="hover:text-white transition-colors">Outerwear & Harrington</a></li>
          <li><a href="/#katalog" class="hover:text-white transition-colors">Celana Pleated & Chino</a></li>
          <li><a href="/#katalog" class="hover:text-white transition-colors">Aksesoris & Tas Kanvas</a></li>
        </ul>
      </div>

      <!-- Supported Local Payment & Shipping -->
      <div class="md:col-span-4 space-y-4">
        <div>
          <h4 class="text-xs font-bold uppercase tracking-widest text-slate-200 mb-3">Metode Pembayaran Resmi</h4>
          <div class="flex flex-wrap gap-2 text-xs font-semibold">
            <span class="px-2.5 py-1 bg-slate-900 border border-slate-800 text-white rounded">📱 QRIS</span>
            <span class="px-2.5 py-1 bg-slate-900 border border-slate-800 text-blue-400 rounded">BCA VA</span>
            <span class="px-2.5 py-1 bg-slate-900 border border-slate-800 text-yellow-400 rounded">Mandiri</span>
            <span class="px-2.5 py-1 bg-slate-900 border border-slate-800 text-blue-300 rounded">BRI</span>
            <span class="px-2.5 py-1 bg-slate-900 border border-slate-800 text-orange-400 rounded">BNI</span>
            <span class="px-2.5 py-1 bg-slate-900 border border-slate-800 text-emerald-400 rounded">COD (Bayar di Tempat)</span>
          </div>
        </div>

        <div>
          <h4 class="text-xs font-bold uppercase tracking-widest text-slate-200 mb-3">Ekspedisi Terpercaya</h4>
          <div class="flex flex-wrap gap-2 text-xs font-semibold text-slate-300">
            <span class="px-2.5 py-1 bg-slate-900 border border-slate-800 rounded">📦 JNE</span>
            <span class="px-2.5 py-1 bg-slate-900 border border-slate-800 rounded">🔴 J&T Express</span>
            <span class="px-2.5 py-1 bg-slate-900 border border-slate-800 rounded">💨 SiCepat</span>
            <span class="px-2.5 py-1 bg-slate-900 border border-slate-800 rounded">🛵 GoSend</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Copyright & System Watermark -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>© 2026 {storeConfig.storeName}. Seluruh hak cipta dilindungi.</p>
      <div class="flex items-center gap-1.5 text-slate-400">
        <span>Dibangun dengan</span>
        <Heart className="w-3.5 h-3.5 text-rose-500 fill-rose-500" />
        <span class="font-medium text-slate-200">Astro.build D2C Engine</span>
        <span class="text-slate-400">• Bebas Komisi Admin</span>
      </div>
    </div>

  </div>
</footer>
